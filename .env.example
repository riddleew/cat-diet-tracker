# Copy this file to .env and fill in real values.
# Both vars are required in production. For local dev, point at the same
# Neon DB and Vercel Blob store you'll use in production (or a separate one).

# Neon Postgres connection string
# Get this from: https://console.neon.tech/ → your project → Connection details → "Pooled connection"
DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require

# Vercel Blob read/write token
# Get this from: Vercel dashboard → your project → Storage → Blob → ".env.local" tab
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx
